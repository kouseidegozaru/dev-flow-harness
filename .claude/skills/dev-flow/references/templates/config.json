{
  "contextWindowTokens": 200000,
  "contextThresholdPercent": 70,
  "minSessionWorkTokens": 40000,
  "hardLimitPercent": 85,
  "maxVerificationRounds": 3,
  "maxAttemptsPerTest": 3,
  "concurrentRunHours": 72,
  "taskContextBudgetKB": 40,
  "test": {
    "command": "dotnet test --logger trx",
    "timeoutSeconds": 900,
    "resultGlobs": ["**/TestResults/*.trx"],
    "files": ["tests/**"]
  },
  "source": {
    "files": ["src/**"]
  },
  "deploy": {
    "timeoutSeconds": 1800,
    "rollbackOnFailure": true,
    "allowWithIssues": false,
    "targets": [
      {
        "name": "staging",
        "command": "pwsh -NoProfile -File scripts/deploy.ps1 -Env staging",
        "smokeCommand": "pwsh -NoProfile -File scripts/smoke.ps1 -Env staging",
        "rollbackCommand": "pwsh -NoProfile -File scripts/rollback.ps1 -Env staging",
        "requiredEnv": ["DEPLOY_TOKEN"]
      },
      {
        "name": "production",
        "command": "pwsh -NoProfile -File scripts/deploy.ps1 -Env production",
        "smokeCommand": "pwsh -NoProfile -File scripts/smoke.ps1 -Env production",
        "rollbackCommand": "pwsh -NoProfile -File scripts/rollback.ps1 -Env production",
        "requiredEnv": ["DEPLOY_TOKEN"]
      }
    ]
  }
}
